# Ferramenta de admin local — usa a Service Role Key do Supabase (acesso total,
# sem restrição de segurança). Nunca deve ir pro repositório público.
admin_gestores.html

# Dumps de importação de dados reais de PDI — contém feedback de desempenho
# de pessoas específicas e credenciais de terceiros embutidas no texto.
# Fica só local, nunca no repositório público.
pdi_import*.sql

# Dumps de importação de avaliações reais de Monitoria — avaliação de
# desempenho de gestores específicos, com comentários sensíveis.
# Fica só local, nunca no repositório público.
monitoria_import*.sql

# E-mails reais de gestores. Fica só local, nunca no repositório público.
pdi_email_backfill.sql

# Importação dos dados reais da Avaliação 360º — avaliações com comentários
# sensíveis sobre gestores específicos. Fica só local, nunca no repositório.
av360_import*.sql

# Auxílios reais da folha (valores por pessoa). Fica só local.
auxilios_import*.sql

# Cargos e salários reais dos gestores. Fica só local.
pessoas_rh_import*.sql
